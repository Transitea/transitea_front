server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API : proxy vers le backend Spring Boot (deploye separement sur Dokploy).
    # API_BACKEND_URL est fourni par variable d'environnement au demarrage du
    # conteneur (substituee ici par le mecanisme de templating de l'image
    # nginx officielle - fichiers .template dans /etc/nginx/templates/) afin
    # de pouvoir pointer vers un backend different par environnement
    # (ex. http://api.transitea.fr en prod, https://api-dev.transitea.fr en dev).
    # /api/v1/... -> ${API_BACKEND_URL}/v1/... : le prefixe /api est retire
    # automatiquement par nginx car location et proxy_pass se terminent tous
    # les deux par /, comme en dev avec le proxy Vite.
    location /api/ {
        proxy_pass ${API_BACKEND_URL}/;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA : toute route non-fichier (ex. /login, /colis/nouveau) retombe sur
    # index.html pour que React Router prenne le relais cote client.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
